# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Lead capture & tracking (set these in Vercel > Project > Settings > Environment Variables) ---
# Emails every quote request to your inbox. Free key at https://web3forms.com
# (enter the email address that should receive enquiries). Public by design.
VITE_WEB3FORMS_KEY=""

# GA4 measurement ID (G-XXXXXXXXXX). Counts enquiries as "generate_lead" events.
VITE_GA_MEASUREMENT_ID=""

# Google Ads conversion, format AW-XXXXXXXXX/ConversionLabel. Fires on every quote submission.
VITE_GOOGLE_ADS_CONVERSION=""
